# Quant AI Mobile Chat PWA & Gateway Environment Variables

# Security PIN for accessing the app on your phone (entered in PWA Settings)
APP_PASSCODE=quant-secret-2026

# Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
DEFAULT_GEMINI_MODEL=gemini-3.7-flash

# Synology NAS Microservices URL & API Key
GEXDEX_API_URL=http://gexdex-api:8000
GEXDEX_API_KEY=YOUR_GEXDEX_API_KEY_HERE

# Public Domain / Cloudflare Ingress URL (e.g. https://quant.yourdomain.com)
PUBLIC_BASE_URL=https://quant.yourdomain.com

# Cloudflare Zero-Trust Tunnel Token (Option A)
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN_HERE
